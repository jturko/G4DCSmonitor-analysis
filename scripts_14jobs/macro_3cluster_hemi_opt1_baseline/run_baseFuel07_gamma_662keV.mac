# ===================================================================
# Auto-generated by generate_macros.sh -- DO NOT EDIT BY HAND
#   base fuel : 7   source : gamma_662keV
#   Loads the ROOT file ONCE, runs 12 casks x 6 hexants (72 runs).
#   3 side-facing clusters + concrete hall (room return).
#   REQUIRES recompiled 22 m world + GeometryHall class.
# ===================================================================

/control/verbose 0
/run/verbose     0
/tracking/verbose 0
/event/verbose   0
/process/verbose 0
/process/em/verbose 0
/process/had/verbose 0

/run/numberOfThreads                64
/dcs-monitor/det/useBiasing         false
/dcs-monitor/det/setBiasingShells   1

## --- Nominal + HemiShield--- inflated cavity: 6cm -> 8cm (inner diam.)
# Detector (tracks central-cluster +x/+y cask at (1580,1580); 115 mm fin standoff)
/dcs-monitor/det/setPosition        3025  1580  0 mm             # 0deg
/dcs-monitor/det/setRotation        0     0     -90
#/dcs-monitor/det/setPosition        2587.63  2587.63  0 mm      # 45 deg
#/dcs-monitor/det/setRotation        0        0        -45
#/dcs-monitor/det/setPosition        1580  3005  0 mm            # 90
#/dcs-monitor/det/setRotation        0     0     0
#/dcs-monitor/det/setPosition        572.37  2587.63  0 mm       # 135
#/dcs-monitor/det/setRotation        0       0        45
#/dcs-monitor/det/setPosition        155  1580  0 mm             # 180
#/dcs-monitor/det/setRotation        0    0    90
#
/dcs-monitor/det/clyc/addByCrystalCenter
/dcs-monitor/det/clyc/setPEPlugLipLength 0 cm
/dcs-monitor/det/clyc/setPEPlugInnerLength 0 cm
/dcs-monitor/det/clyc/setPEColLength 0 cm
/dcs-monitor/det/clyc/setPbColLength 0 cm
# HemiShield
/dcs-monitor/det/setPosition        3025  1580  0 mm             # 0deg
/dcs-monitor/det/setRotation        0     0     -90
#
/dcs-monitor/det/hemishield/add
/dcs-monitor/det/hemishield/setBoreOffsetY       5 cm # 3 cm (nom) + 2 cm (equiv thickness to walls)
/dcs-monitor/det/hemishield/setCavityRadius      8.5 cm # 6 cm (nom) + 2 cm + 0.5 cm (cushion)
/dcs-monitor/det/hemishield/setBoronMassFraction 0.05
/dcs-monitor/det/hemishield/setLinerThickness    0 cm
/dcs-monitor/det/hemishield/setLinerMaterial     G4_AIR
/dcs-monitor/det/hemishield/setPEThickness       16.5 cm # nominal value for 1st opt. is 16.5 cm
/dcs-monitor/det/hemishield/setGammaMaterial     G4_Pb
/dcs-monitor/det/hemishield/setGammaThickness    2 cm
/dcs-monitor/det/hemishield/setGammaCollimatorMaterial     G4_Pb
/dcs-monitor/det/hemishield/setGammaCollimatorThickness    2 cm

# =====================================================================
#  THREE CASTOR 440/84 clusters, side-facing 2x2 squares, SYMMETRIC
#  about the y-axis. Intra pitch 3160 mm (500 mm gaps); inter-cluster
#  gap 2000 mm (centroid pitch 7820 mm). All rot 0 (hexant on source).
#  Add-order == caskNum: central=0-3, +x=4-7, -x=8-11.
# =====================================================================
/dcs-monitor/det/setRotation           0     0     0
# --- CENTRAL cluster (caskNum 0-3); cask 0 = detector target ---
/dcs-monitor/det/setPosition        1580  1580     0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition        1580 -1580     0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition       -1580  1580     0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition       -1580 -1580     0 mm
/dcs-monitor/det/castor440/add
# --- +x cluster (caskNum 4-7) ---
/dcs-monitor/det/setPosition        6240  1580     0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition        6240 -1580     0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition        9400  1580     0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition        9400 -1580     0 mm
/dcs-monitor/det/castor440/add
# --- -x cluster (caskNum 8-11) ---
/dcs-monitor/det/setPosition       -6240  1580     0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition       -6240 -1580     0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition       -9400  1580     0 mm
/dcs-monitor/det/castor440/add
/dcs-monitor/det/setPosition       -9400 -1580     0 mm
/dcs-monitor/det/castor440/add

# --- storage hall (floor + 2 walls) for room return ---
/dcs-monitor/det/setPosition           0     0     0 mm
/dcs-monitor/det/setRotation           0     0     0
/dcs-monitor/det/hall/add
/dcs-monitor/det/hall/setLength      22000 mm
/dcs-monitor/det/hall/setWallInnerY   5410 mm
/dcs-monitor/det/hall/setFloorTopZ   -2040 mm
/dcs-monitor/det/hall/setUseCeiling   false

/run/initialize
/process/had/rdm/thresholdForVeryLongDecayTime 1e60 year

# source config (set ONCE; ROOT load happens lazily on first startRun)
/dcs-monitor/gun/sourceMode     CASTOR440_surface_from_TTree
/dcs-monitor/surf/sourcePid     0
/dcs-monitor/surf/smearPhi      0.005
/dcs-monitor/surf/smearZ        10.0 mm
/dcs-monitor/surf/smearAngle    0.02
/dcs-monitor/surf/smearEfrac    0.0
/dcs-monitor/surf/numPrimaries  100000000
/dcs-monitor/surf/sourceFile    /home/turko46/data/SurfaceFlux_v3/gamma_662keV/using/surface_gamma-662keV_fuel7_nShells28_nEvts100000000.root

/dcs-monitor/run/writePrimaryOnlyOnHit  true
/dcs-monitor/run/writePrimary           false
/dcs-monitor/run/writeSurfaceFlux       false

